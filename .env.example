# Public address of the server, used in the Market catalog and download links.
PUBLIC_URL=http://34.155.86.153
# ":80" serves plain HTTP on the IP. With a domain pointing here, put it instead
# (e.g. DOMAIN=cloud.example.com, PUBLIC_URL=https://cloud.example.com) for HTTPS.
DOMAIN=:80
# 32 random bytes, hex: openssl rand -hex 32. Keep a copy offline: without it the
# contacts backups can't be decrypted.
MASTER_KEY=
# First admin account, created at the first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
MAX_APKG_MB=300
# WhatsAstra (WhatsApp through OpenWA): OpenWA's API key. It is created on
# OpenWA's first start: copy it from openwa/.api-key (sudo cat openwa/.api-key).
OPENWA_API_KEY=
